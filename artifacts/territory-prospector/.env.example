# Google Maps Platform browser key. Enable "Maps JavaScript API" and
# "Places API (New)" for the key, and restrict it to your site's referrers.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Cloud-styled Map ID. Advanced markers need a map id; when unset
# the app falls back to Google's DEMO_MAP_ID (fine for development).
VITE_GOOGLE_MAPS_MAP_ID=
