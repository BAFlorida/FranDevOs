# Copy to .env and fill in. Required to run the API server and DB tooling.

# Postgres connection string used by the API server, seed, and schema tooling.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frandevos

# Port the API server (@workspace/api-server) listens on. Docs assume 5000.
PORT=5000

# NODE_ENV: "development" enables the dev auth bypass (auto-signs in as the
# highest-privilege user so you can click around without logging in).
# Use "production" to exercise the real login flow.
NODE_ENV=development

# --- Web app (@workspace/franchise-dev-os) ---
# Base path the web app is served under. "/" for a standard root deployment.
# (Replit injected a sub-path here.)
BASE_PATH=/

# Where the Vite dev server proxies /api requests. Defaults to the API server
# above; only set this if the API runs on a different host/port.
# API_PROXY_TARGET=http://localhost:5000

# --- Owner (Super Admin) account ---
# The first account bootstrapped on startup. Defaults preserve the original
# owner; set these to make someone else the owner on a fresh database.
SUPER_ADMIN_EMAIL=Ryan@myfieldspec.com
SUPER_ADMIN_NAME=Ryan Maynard

# --- Automated email (invites + owner setup link) ---
# When RESEND_API_KEY is unset, the app skips sending and you share invite links
# manually (copy from the admin UI / server logs). To turn on automated email:
#   1. Create a free account at https://resend.com and add an API key below.
#   2. Verify your sending domain there, then set MAIL_FROM to an address on it.
#   3. Set APP_URL to the app's public URL so email links are absolute.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Franchise Dev OS <noreply@yourdomain.com>
# APP_URL=https://your-app.onrender.com
